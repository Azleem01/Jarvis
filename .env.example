# ---- Jarvis configuration ----
# Copy this file to ".env" and fill in your values.

# Free Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Primary Gemini model used for intent routing + vision.
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated fallback chain, tried in order when the primary model is rate
# limited (429), out of quota, retired (404), or having a bad day (5xx).
# Leave blank to use the built-in defaults in config.py. Every model listed
# must support both function calling and vision.
GEMINI_FALLBACK_MODELS=

# Seconds to skip a model after it reports quota exhaustion, when the API
# doesn't supply its own retry delay.
MODEL_COOLDOWN_SECONDS=60

# Optional. A GitHub token with "gist" scope lets solve_with_python upload its
# solution as a secret gist and return a shareable Colab link. Leave blank to
# skip sharing; the solution still runs and is reported.
GITHUB_TOKEN=

# Push-to-talk hotkey. Options: "caps_lock" (hold) or "ctrl_space" (hold ctrl+space).
HOTKEY=ctrl_space

# How long the hotkey must be held before the mic opens. A shorter tap is
# ignored. Keep this low (0.2-0.3) for ctrl_space; with caps_lock you may want
# ~1.0 or more so a normal tap still works as Caps Lock.
HOLD_SECONDS=0.25

# Show the blue recording HUD while capturing. false/0 to run without it.
SHOW_OVERLAY=true

# faster-whisper model: tiny(.en) | base(.en) | small.en | medium.en | large-v3
# | distil-large-v3. Default 'small.en' is much better on names like 'Jarvis'
# and contacts than 'base', still fine on CPU. Use 'distil-large-v3' for maximum
# accuracy (bigger download + RAM), 'base.en' for maximum speed. Downloaded
# automatically on first run.
WHISPER_MODEL=small.en

# "cpu" or "cuda" (if you have an NVIDIA GPU + CUDA installed)
WHISPER_DEVICE=cpu

# Compute type. For CPU use "int8". For GPU try "float16".
WHISPER_COMPUTE_TYPE=int8

# Decoding beam width. 1 (greedy) is the fastest and is the default; raise
# toward 5 only if you dictate long or unusual phrases and see mistakes.
WHISPER_BEAM_SIZE=1

# Optional JSON map of transcription mishears -> corrections, applied after
# decoding. Merged with a small built-in set for the assistant's name
# ('diabetes'->'Jarvis'). Add your own risky-but-useful ones here.
# Example: {"travis":"Jarvis","javis":"Jarvis"}
STT_CORRECTIONS=

# ---- Computer-use agent ----
# Pause after each on-screen action before the next screenshot. Lower is
# faster; too low and the agent decides against a half-painted screen.
AGENT_SETTLE_SECONDS=0.45

# Maximum actions in a single on-screen task before it reports back.
AGENT_MAX_STEPS=12

# Thinking tokens per click/type decision. 0 keeps steps fast and is right for
# mechanical actions. Knowledge work does not run through this loop — quizzes
# have their own tool, which always reasons.
AGENT_THINKING_BUDGET=0

# ---- OpenRouter (optional second provider) ----
# Gemini's free tier allows 20 requests per DAY per model, which one quiz
# exceeds. OpenRouter serves the repetitive vision work from free models so
# that cap stops being the limiting factor. Leave the key blank to run on
# Gemini alone — nothing breaks, the quota is just tighter.
# Free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Which provider answers vision requests first: "openrouter" or "gemini".
# Tool routing always stays on Gemini; free models route measurably worse.
# NOTE: Azleem sends screenshots of your desktop. OpenRouter's free model
# variants generally require allowing providers that may retain prompts for
# training (openrouter.ai/settings/privacy). Set this to "gemini" if you would
# rather that never happen.
VISION_PROVIDER=openrouter

# Models allowed to return a box that will be CLICKED. Benchmarked: the Gemma
# free models land within ~7/1000 of an option's centre; the Nvidia Nemotron
# ones miss by up to 231/1000, which selects the wrong answer while reporting
# the right one. Do not add a model here without measuring it.
# Comma-separated; blank uses the measured defaults.
OPENROUTER_POINTING_MODELS=

# Models allowed to READ the screen (no clicking). Safe to be broader.
OPENROUTER_VISION_MODELS=

# ---- Quiz answering ----
# Hard cap on questions in one run, so a misread page can't loop forever.
QUIZ_MAX_QUESTIONS=30

# ---- Conversation memory ---------------------------------------------------
# How long a command stays available as context for the next one, in seconds.
# Follow-ups ("now search it for jazz", "do that again") need the previous turn;
# after this much idle time the history is dropped so a stale antecedent can't
# be resurrected. Set HISTORY_TURNS=0 to disable follow-ups entirely.
HISTORY_IDLE_SECONDS=180
HISTORY_TURNS=5

# Folder searched by search_and_open_file when folder="Downloads".
# Leave blank to use "%USERPROFILE%\Downloads".
DOWNLOADS_DIR=

# WhatsApp contacts as a JSON object mapping a spoken name -> E.164 phone number.
# OPTIONAL now: if a name isn't here, Azleem opens WhatsApp and searches for it
# by name instead. Providing a number just makes that person's sends instant.
# Example: {"mum":"+15551234567","alex":"+447700900123"}
WHATSAPP_CONTACTS={}

# Where Azleem saves contacts it discovers itself (names it has messaged, and
# names captured by "save my whatsapp contacts"). Defaults to a private,
# git-ignored file under logs/. This is additive; it never edits WHATSAPP_CONTACTS.
WHATSAPP_CONTACT_CACHE=

# WhatsApp timing. SEND_TIMEOUT: seconds to wait for the app window to appear.
# SETTLE_SECONDS: pause that lets the chat/message box populate before typing.
# MAX_SCROLLS: safety cap on how far "save my whatsapp contacts" will scroll.
WHATSAPP_SEND_TIMEOUT=8.0
WHATSAPP_SETTLE_SECONDS=0.6
WHATSAPP_MAX_SCROLLS=40
